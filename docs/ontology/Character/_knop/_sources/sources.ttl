@base <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/Character/_knop/_sources> a sflo:KnopSourceRegistry, sflo:DigitalArtifact, sflo:RdfDocument ;
  sflo:hasWorkingLocatedFile <ontology/Character/_knop/_sources/sources.ttl> ;
  sflo:hasSourceBinding <ontology/Character/_knop/_sources#extraction-source> .

<ontology/Character/_knop/_sources#extraction-source> a sflo:ExtractionSource ;
  sflo:targetArtifact <ontology> ;
  sflo:targetHistoricalState <ontology/_history001/_s0001> ;
  sflo:hasResolutionObservation <ontology/Character/_knop/_sources#extraction-source-observation-001> .

<ontology/Character/_knop/_sources#extraction-source-observation-001> a sflo:ArtifactResolutionObservation ;
  sflo:observedArtifactResolutionSpec [
    a sflo:ArtifactResolutionSpec ;
    sflo:targetHistoricalState <ontology/_history001/_s0001> ;
    sflo:targetManifestation <ontology/_history001/_s0001/ttl> ;
    sflo:targetLocatedFile <ontology/_history001/_s0001/ttl/fantasy-rules-ontology.ttl>
  ] ;
  sflo:observedContentDigest "sha256:59d700fcb8ae22181d131668df4ccf2cb58b70b37c3bcabea4b38fece15f3bb0" .

<ontology/Character/_knop/_sources/sources.ttl> a sflo:LocatedFile, sflo:RdfDocument .
