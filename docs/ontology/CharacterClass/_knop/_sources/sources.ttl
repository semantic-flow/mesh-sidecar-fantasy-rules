@base <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/CharacterClass/_knop/_sources> a sflo:KnopSourceRegistry, sflo:DigitalArtifact, sflo:RdfDocument ;
  sflo:hasWorkingLocatedFile <ontology/CharacterClass/_knop/_sources/sources.ttl> ;
  sflo:hasSourceBinding <ontology/CharacterClass/_knop/_sources#extraction-source> .

<ontology/CharacterClass/_knop/_sources#extraction-source> a sflo:ExtractionSource ;
  sflo:targetArtifact <ontology> ;
  sflo:targetHistoricalState <ontology/releases/v0.0.2> ;
  sflo:hasResolutionObservation <ontology/CharacterClass/_knop/_sources#extraction-source-observation-001> .

<ontology/CharacterClass/_knop/_sources#extraction-source-observation-001> a sflo:ArtifactResolutionObservation ;
  sflo:observedArtifactResolutionSpec [
    a sflo:ArtifactResolutionSpec ;
    sflo:targetHistoricalState <ontology/releases/v0.0.2> ;
    sflo:targetManifestation <ontology/releases/v0.0.2/ttl> ;
    sflo:targetLocatedFile <ontology/releases/v0.0.2/ttl/fantasy-rules-ontology.ttl>
  ] ;
  sflo:observedContentDigest "sha256:c8fe09dcea187f153c3f61a53abdf66aa0704208a02cf66cf8017b0d40383acf" .

<ontology/CharacterClass/_knop/_sources/sources.ttl> a sflo:LocatedFile, sflo:RdfDocument .
