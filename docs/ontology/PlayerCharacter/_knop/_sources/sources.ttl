@base <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/PlayerCharacter/_knop/_sources> a sflo:KnopSourceRegistry, sflo:DigitalArtifact, sflo:RdfDocument ;
  sflo:hasWorkingLocatedFile <ontology/PlayerCharacter/_knop/_sources/sources.ttl> ;
  sflo:hasSourceBinding <ontology/PlayerCharacter/_knop/_sources#extraction-source> .

<ontology/PlayerCharacter/_knop/_sources#extraction-source> a sflo:ExtractionSource ;
  sflo:targetArtifact <ontology> ;
  sflo:hasArtifactResolutionMode <https://semantic-flow.github.io/sflo/ontology/artifactResolutionMode_working> ;
  sflo:hasResolutionObservation <ontology/PlayerCharacter/_knop/_sources#extraction-source-observation-001> .

<ontology/PlayerCharacter/_knop/_sources#extraction-source-observation-001> a sflo:ArtifactResolutionObservation ;
  sflo:observedArtifactResolutionSpec [
    a sflo:ArtifactResolutionSpec ;
    sflo:targetLocalRelativePath "../ontology/fantasy-rules-ontology.ttl"
  ] ;
  sflo:observedContentDigest "sha256:59d700fcb8ae22181d131668df4ccf2cb58b70b37c3bcabea4b38fece15f3bb0" .

<ontology/PlayerCharacter/_knop/_sources/sources.ttl> a sflo:LocatedFile, sflo:RdfDocument .
